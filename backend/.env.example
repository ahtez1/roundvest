# Copy this file to .env and fill in as needed.
# Leaving PLAID_* and ALPACA_* blank runs the app in fully offline demo mode
# (fake Plaid transactions, fake Alpaca fills) - no signups required.

SECRET_KEY=change-me-to-something-random
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Plaid Sandbox (https://dashboard.plaid.com/) - leave blank for fake mode
PLAID_CLIENT_ID=
PLAID_SECRET=

# Alpaca Paper Trading (https://alpaca.markets/) - leave blank for fake mode
ALPACA_API_KEY=
ALPACA_API_SECRET=
